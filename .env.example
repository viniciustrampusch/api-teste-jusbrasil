# Optional runtime overrides. Spring Boot reads these variables directly.
# Do not put secrets in this file. Supply secrets through the environment
# or a secret manager, never through a committed file.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Required by `docker compose up` and by the dev profile datasource.
# Set the value in the environment or in an untracked .env file. Leave it empty here.
POSTGRES_PASSWORD=
